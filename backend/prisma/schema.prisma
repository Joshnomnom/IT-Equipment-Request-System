generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  ADMIN
}

enum EquipmentStatus {
  ACTIVE
  INACTIVE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(EMPLOYEE)
  createdAt    DateTime @default(now()) @map("created_at")

  requests         Requisition[] @relation("RequestedBy")
  reviewedRequests Requisition[] @relation("ReviewedBy")
  auditLogs        AuditLog[]

  @@map("users")
}

model Equipment {
  id            Int             @id @default(autoincrement())
  name          String
  category      String
  stockQuantity Int             @map("stock_quantity")
  status        EquipmentStatus @default(ACTIVE)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  requests Requisition[]

  @@map("equipment")
}

model Requisition {
  id           Int           @id @default(autoincrement())
  userId       Int           @map("user_id")
  equipmentId  Int           @map("equipment_id")
  quantity     Int
  reason       String
  status       RequestStatus @default(PENDING)
  rejectReason String?       @map("reject_reason")
  reviewedById Int?          @map("reviewed_by")
  approvedAt   DateTime?     @map("approved_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  user       User       @relation("RequestedBy", fields: [userId], references: [id])
  equipment  Equipment  @relation(fields: [equipmentId], references: [id])
  reviewedBy User?      @relation("ReviewedBy", fields: [reviewedById], references: [id])
  auditLogs  AuditLog[]

  @@index([status])
  @@index([userId])
  @@map("requisitions")
}

model AuditLog {
  id             Int            @id @default(autoincrement())
  userId         Int            @map("user_id")
  requestId      Int            @map("request_id")
  previousStatus RequestStatus? @map("previous_status")
  newStatus      RequestStatus  @map("new_status")
  createdAt      DateTime       @default(now()) @map("created_at")

  user    User        @relation(fields: [userId], references: [id])
  request Requisition @relation(fields: [requestId], references: [id])

  @@index([requestId])
  @@map("audit_logs")
}
